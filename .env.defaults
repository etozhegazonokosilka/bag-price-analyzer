# внутренние дефолты проекта без секретов
# файл загружается после .env через setdefault поэтому .env имеет приоритет

# запуск api
PORT=5002
USE_RENDER=0

# telegram транспорт
TELEGRAM_PROXY_URL=
TELEGRAM_CONNECT_TIMEOUT=15
TELEGRAM_READ_TIMEOUT=60
TELEGRAM_POLLING_TIMEOUT=10
TELEGRAM_LONG_POLLING_TIMEOUT=10

# visual фильтрация и clip
VISUAL_SIMILARITY_ENABLED=0
SIMILARITY_THRESHOLD=0.87
ENABLE_COLOR_CHECK=1
COLOR_SIMILARITY_THRESHOLD=0.75
ENABLE_PHASH_CHECK=1
PHASH_THRESHOLD=14
MAX_RESULTS_TO_CHECK=30
BATCH_SIZE=8
MAX_PAGES_TO_SCRAPE=30
MAX_PARALLEL_SCRAPERS=6
