# required integrations
SERPAPI_KEY=
OPENAI_API_KEY=

# application
PORT=5002
PUBLIC_BASE_URL=
LOCAL_TITLE_AI_ENABLED=1
LOCAL_TITLE_AI_PROVIDER=openai
LOCAL_TITLE_AI_MODEL=gpt-4.1-mini

# optional currency provider
EXCHANGE_RATE_API_KEY=

# optional marketplace/API integrations
EBAY_API_KEY=
EBAY_API_SECRET=
EBAY_API_ENV=production
ZENROWS_API_KEY=
IMGBB_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_FALLBACK_ENABLED=0

# optional Cloudflare R2 temporary storage
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_S3_ENDPOINT=
R2_PUBLIC_BASE_URL=

# optional proxies: never commit real credentials
ROTATING_PROXY_URLS=
ROTATING_PROXY_ROTATE_URLS=
STATIC_PROXIES_FILE=proxies_static.txt

# optional components
VISUAL_SIMILARITY_ENABLED=0
REPORT_QUEUE_ENABLED=0
REPORT_QUEUE_REDIS_URL=redis://127.0.0.1:6379/0
REPORT_QUEUE_NAME=reports
